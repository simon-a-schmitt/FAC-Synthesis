# Cluster-specific settings (bwUniCluster 3.0) - the ONLY place for them. Sourced by every job
# script under experiments/slurm/:
#   source "${CLUSTER_ENV:-$REPO/experiments/config/cluster.env}"
#
# For a second cluster create another file next to this one (e.g. cluster_<name>.env) with the
# same variables and select it via `sbatch --export=ALL,CLUSTER_ENV=<path> ...`; this file stays
# the default.
#
# Note: #SBATCH headers cannot read variables, so the job scripts carry a literal default
# partition there; GPU_PARTITION/CPU_PARTITION are what the orchestration passes as
# `sbatch --partition=...` and what the header comments refer to.

# ---- Workspace ---------------------------------------------------------------
WS_NAME="master_thesis_exp"
if [[ -z "${WS_PATH:-}" ]]; then
    command -v ws_find >/dev/null 2>&1 || { echo "FEHLER: 'ws_find' ist nicht im PATH verfügbar." >&2; return 1; }
    WS_PATH="$(ws_find "$WS_NAME")"
fi
export WS_PATH
[[ -d "$WS_PATH" ]] || { echo "FEHLER: Workspace-Pfad '$WS_PATH' existiert nicht." >&2; return 1; }

# ---- Software ------------------------------------------------------------------
START_LLAMA_SH="$WS_PATH/start_llama.sh"                 # benchmark env (fac_env)
MAMBA_ROOT="$WS_PATH/software/miniforge3"
FT_ENV_DIR="$WS_PATH/software/envs/ft_pipeline_env"      # LLaMA-Factory env
export HF_HOME="$WS_PATH/hf_cache"
export HF_DATASETS_CACHE="$HF_HOME/datasets"

# ---- SLURM partitions ------------------------------------------------------------
GPU_PARTITION="gpu_a100_short"      # max 30 min: fine-tuning + benchmark (ft_bench_job.sh)
CPU_PARTITION="cpu"                 # max 3 d: blackbox generation, labeling (gen_job.sh, label_build_job.sh)
# Long GPU jobs: feature-guided / hybrid generation (gen_job.sh), max 2 d. Each fg/hybrid run of a
# pack is its own process with its own Llama-3.1-8B + SAE on the job's single GPU, so the number of
# runs per job (GEN_PACK_SIZE) is bounded by GPU memory. Variants on this cluster:
#   A100 40GB (gpu_a100_short)      GEN_PACK_SIZE=2   (2 x ~17-18 GB)
#   A100 80GB (gpu_a100_il)         GEN_PACK_SIZE=4   (4 x ~17-18 GB)
#   H100 94GB (gpu_h100, _il)       GEN_PACK_SIZE=4
GPU_LONG_PARTITION="gpu_a100_il"
GEN_PACK_SIZE=4
