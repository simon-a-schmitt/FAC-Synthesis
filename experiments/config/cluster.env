# Cluster-specific settings (bwUniCluster 3.0) - the ONLY place for them. Sourced by every job
# script under experiments/slurm/:
#   source "${CLUSTER_ENV:-$REPO/experiments/config/cluster.env}"
#
# For a second cluster create another file next to this one (e.g. cluster_<name>.env) with the
# same variables and select it via `sbatch --export=ALL,CLUSTER_ENV=<path> ...`; this file stays
# the default.
#
# Note: #SBATCH headers cannot read variables, so the job scripts carry a literal default
# partition there; GPU_PARTITION/CPU_PARTITION are what the orchestration passes as
# `sbatch --partition=...` and what the header comments refer to.

# ---- Workspace ---------------------------------------------------------------
WS_NAME="master_thesis_exp"
if [[ -z "${WS_PATH:-}" ]]; then
    command -v ws_find >/dev/null 2>&1 || { echo "FEHLER: 'ws_find' ist nicht im PATH verfügbar." >&2; return 1; }
    WS_PATH="$(ws_find "$WS_NAME")"
fi
export WS_PATH
[[ -d "$WS_PATH" ]] || { echo "FEHLER: Workspace-Pfad '$WS_PATH' existiert nicht." >&2; return 1; }

# ---- Software ------------------------------------------------------------------
START_LLAMA_SH="$WS_PATH/start_llama.sh"                 # benchmark env (fac_env)
MAMBA_ROOT="$WS_PATH/software/miniforge3"
FT_ENV_DIR="$WS_PATH/software/envs/ft_pipeline_env"      # LLaMA-Factory env
export HF_HOME="$WS_PATH/hf_cache"
export HF_DATASETS_CACHE="$HF_HOME/datasets"

# ---- SLURM partitions + job classes (experiments/submit.py passes these as sbatch options) ----
GPU_PARTITION="gpu_a100_short"      # A100 40GB, max 30 min
CPU_PARTITION="cpu"                 # max 3 d

# ft_bench_job.sh (fine-tuning + benchmark) and label_build_job.sh (labeling + LF dataset)
FT_BENCH_PARTITION="$GPU_PARTITION";  FT_BENCH_TIME="00:30:00"
LABEL_BUILD_PARTITION="$CPU_PARTITION"; LABEL_BUILD_TIME="00:30:00"
# api_bench_job.sh (benchmark of the api arm via OpenRouter, no GPU)
API_BENCH_PARTITION="$CPU_PARTITION"; API_BENCH_TIME="02:00:00"

# gen_job.sh, GPU packs (fg/hybrid). Each run of a pack is its own process with its own
# Llama-3.1-8B + SAE (measured: 17.6 GB per process, 35.2 GB for a pack of 2 on A100 40GB), so
# GEN_PACK_SIZE is bounded by GPU memory: A100 40GB -> 2, A100 80GB / H100 94GB -> 4.
# The short partition is the default because the long ones (gpu_a100_il, gpu_h100) had queue
# waits of several days; runs longer than GEN_TIME continue via self-requeue (gen_job.sh: SIGUSR1
# 120 s before the limit -> runs stop cleanly -> scontrol requeue, at most GEN_MAX_REQUEUES times).
# GPU_LONG_PARTITION is only an option (set GEN_PARTITION/GEN_TIME/GEN_PACK_SIZE accordingly).
GEN_PARTITION="gpu_a100_short"; GEN_TIME="00:30:00"; GEN_GRES="gpu:1"; GEN_PACK_SIZE=2
GPU_LONG_PARTITION="gpu_a100_il"    # A100 80GB, max 2 d
# gen_job.sh, CPU packs (bb): API-bound, no GPU.
GEN_CPU_PARTITION="$CPU_PARTITION"; GEN_CPU_TIME="02:00:00"; GEN_PACK_SIZE_CPU=4
GEN_MAX_REQUEUES="${GEN_MAX_REQUEUES:-6}"  # self-requeues per gen job before it fails (env override for tests)
# API throttle: at most GEN_MAX_LANES generation jobs at once (job names gen_lane_<i> + singleton).
GEN_MAX_LANES=4
